<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="generate-diagram.js" version="24.7.17" type="device">
  <diagram id="p1" name="1 End-to-End Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p1_0" />
        <mxCell id="p1_1" parent="p1_0" />
        <mxCell id="p1_title" value="FoodExpress: from &lt;i&gt;git push&lt;/i&gt; to a running application on Amazon EC2" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="p1_1">
          <mxGeometry x="20" y="12" width="1880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1_subtitle" value="What this repository really contains: GitLab CI/CD → Amazon S3 → AWS CodeDeploy → one EC2 instance. There is no Jenkins, Docker, Amazon ECR, Amazon EKS / Kubernetes, Prometheus or Grafana in the repository." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;" vertex="1" parent="p1_1">
          <mxGeometry x="20" y="48" width="1880" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1_zA" value="A · Developer and GitLab" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF4FB;strokeColor=#1F4E79;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="p1_1">
          <mxGeometry x="20" y="90" width="300" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p1_dev" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;Writes and tests code on a laptop." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zA">
          <mxGeometry x="20" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1_ide" value="&lt;b&gt;VS Code + Claude Code&lt;/b&gt;&lt;br&gt;Claude Code is an AI assistant inside the editor. It helps write and review application code, the pipeline file, deploy scripts and documentation.&lt;br&gt;&lt;i&gt;It is not part of the pipeline and does not trigger it.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zA">
          <mxGeometry x="20" y="130" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1_git" value="&lt;b&gt;Local Git repository&lt;/b&gt;&lt;br&gt;Default branch: &lt;font face=&quot;Courier New&quot;&gt;main&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;git commit&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;git push origin main&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zA">
          <mxGeometry x="20" y="320" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1_gitlab" value="&lt;b&gt;GitLab.com project&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;devops_slate/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;foodexpress-monolithic-nodejs&lt;/font&gt;&lt;br&gt;Stores the source code. Every push starts a pipeline defined in &lt;font face=&quot;Courier New&quot;&gt;.gitlab-ci.yml&lt;/font&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zA">
          <mxGeometry x="20" y="450" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1_mr" value="&lt;b&gt;Branches and merge requests&lt;/b&gt;&lt;br&gt;Push to any branch: &lt;b&gt;test&lt;/b&gt; only. Push to main: all three stages. No merge-request pipeline is configured." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A300;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#4E3B00;" vertex="1" parent="p1_zA">
          <mxGeometry x="20" y="600" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_dev_ide" value="writes code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E79;endArrow=block;endFill=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1_1" source="p1_dev" target="p1_ide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_ide_git" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E79;endArrow=block;endFill=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1_1" source="p1_ide" target="p1_git">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_git_gitlab" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E79;endArrow=block;endFill=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1_1" source="p1_git" target="p1_gitlab">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_zB" value="B · GitLab CI/CD (.gitlab-ci.yml)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFF4E5;strokeColor=#C55A11;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#C55A11;" vertex="1" parent="p1_1">
          <mxGeometry x="340" y="90" width="330" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p1_s1" value="&lt;b&gt;① test&lt;/b&gt;&lt;br&gt;Image: &lt;font face=&quot;Courier New&quot;&gt;node:20&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;npm ci&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;npm test&lt;/font&gt; (12 tests)&lt;br&gt;Runs on every branch." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zB">
          <mxGeometry x="20" y="40" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1_s2" value="&lt;b&gt;② package&lt;/b&gt;&lt;br&gt;Image: &lt;font face=&quot;Courier New&quot;&gt;node:20&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;git archive&lt;/font&gt; → &lt;font face=&quot;Courier New&quot;&gt;foodexpress.zip&lt;/font&gt;&lt;br&gt;Saved as a job artifact for 1 week.&lt;br&gt;Default branch only." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zB">
          <mxGeometry x="20" y="195" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1_s3" value="&lt;b&gt;③ deploy&lt;/b&gt;&lt;br&gt;Image: &lt;font face=&quot;Courier New&quot;&gt;amazon/aws-cli:latest&lt;/font&gt;&lt;br&gt;🔒 Signs in with a GitLab OIDC token. No AWS keys are stored.&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;aws s3 cp&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;aws deploy create-deployment&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;aws deploy wait deployment-successful&lt;/font&gt;&lt;br&gt;Environment: production. One deployment at a time. Default branch only." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zB">
          <mxGeometry x="20" y="350" width="290" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p1_pfail" value="&lt;b&gt;✖ If any stage fails&lt;/b&gt;&lt;br&gt;The pipeline stops and later stages do not run. No automatic rollback is configured." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#8E1B1B;" vertex="1" parent="p1_zB">
          <mxGeometry x="20" y="590" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_gitlab_s1" value="push starts pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E79;endArrow=block;endFill=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1_1" source="p1_gitlab" target="p1_s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_s1_s2" value="tests passed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E79;endArrow=block;endFill=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1_1" source="p1_s1" target="p1_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_s2_s3" value="zip artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1F4E79;endArrow=block;endFill=1;fontSize=10;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1_1" source="p1_s2" target="p1_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_s3_fail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#C62828;endArrow=block;endFill=1;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1_1" source="p1_s3" target="p1_pfail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_aws" value="C · AWS Cloud (region = ${AWS_DEFAULT_REGION})" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;strokeWidth=2;" vertex="1" parent="p1_1">
          <mxGeometry x="690" y="90" width="890" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p1_oidc" value="&lt;b&gt;IAM identity provider&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;gitlab.com&lt;/font&gt; (OpenID Connect)&lt;br&gt;Created by hand, see walkthrough." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=52;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_aws">
          <mxGeometry x="20" y="45" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1_oidc_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="p1_oidc">
          <mxGeometry x="8" y="8" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_role" value="&lt;b&gt;🔒 IAM role for the pipeline&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;${AWS_ROLE_ARN}&lt;/font&gt;&lt;br&gt;Trusts only this project and the main branch. May upload the zip and start a deployment." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=52;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_aws">
          <mxGeometry x="20" y="155" width="240" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p1_role_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="p1_role">
          <mxGeometry x="8" y="8" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_s3b" value="&lt;b&gt;Amazon S3 bucket&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;${S3_BUCKET}&lt;/font&gt;&lt;br&gt;Key: &lt;font face=&quot;Courier New&quot;&gt;foodexpress/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;lt;short commit id&amp;gt;.zip&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=52;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_aws">
          <mxGeometry x="20" y="310" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_s3b_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="p1_s3b">
          <mxGeometry x="8" y="8" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_cd" value="&lt;b&gt;AWS CodeDeploy&lt;/b&gt;&lt;br&gt;App:&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;${CODEDEPLOY_APPLICATION}&lt;/font&gt;&lt;br&gt;Group:&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;${CODEDEPLOY_DEPLOYMENT_GROUP}&lt;/font&gt;&lt;br&gt;Finds the server by its tag (documented: App = foodexpress)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;spacingLeft=52;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_aws">
          <mxGeometry x="20" y="440" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1_cd_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codedeploy;" vertex="1" parent="p1_cd">
          <mxGeometry x="8" y="8" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_svc" value="&lt;b&gt;Other IAM roles (documented)&lt;/b&gt;&lt;br&gt;CodeDeploy service role and EC2 instance role. Not defined as code in the repo." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6A300;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#4E3B00;" vertex="1" parent="p1_aws">
          <mxGeometry x="20" y="610" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1_ec2" value="EC2 instance · Amazon Linux 2023 · single server" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFFBF5;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;strokeWidth=2;" vertex="1" parent="p1_aws">
          <mxGeometry x="310" y="45" width="565" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p1_agent" value="&lt;b&gt;CodeDeploy agent&lt;/b&gt;&lt;br&gt;Installed once by hand. Polls CodeDeploy, downloads the zip from S3 with the instance role, runs &lt;font face=&quot;Courier New&quot;&gt;appspec.yml&lt;/font&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_ec2">
          <mxGeometry x="15" y="40" width="255" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_hooks" value="&lt;b&gt;appspec.yml lifecycle&lt;/b&gt;&lt;br&gt;&lt;b&gt;Install:&lt;/b&gt; copy files to &lt;font face=&quot;Courier New&quot;&gt;/opt/foodexpress&lt;/font&gt;&lt;br&gt;&lt;b&gt;AfterInstall:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;deploy/setup-ec2.sh&lt;/font&gt;&lt;br&gt;Node.js 20, &lt;font face=&quot;Courier New&quot;&gt;npm ci --omit=dev&lt;/font&gt;, restart.&lt;br&gt;&lt;b&gt;ValidateService:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;deploy/validate-service.sh&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_ec2">
          <mxGeometry x="15" y="170" width="255" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p1_systemd" value="&lt;b&gt;systemd service: foodexpress&lt;/b&gt;&lt;br&gt;User &lt;font face=&quot;Courier New&quot;&gt;foodexpress&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;NODE_ENV=production&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Restart=on-failure&lt;/font&gt;. Starts on boot." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_ec2">
          <mxGeometry x="15" y="355" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1_env" value="&lt;b&gt;🔒 /opt/foodexpress/.env&lt;/b&gt;&lt;br&gt;PORT and SMTP settings. Never in Git, never in the zip. File mode 600. Deployments keep it." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_ec2">
          <mxGeometry x="15" y="480" width="255" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1_logs" value="&lt;b&gt;Logs: journald&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;journalctl -u foodexpress&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_ec2">
          <mxGeometry x="15" y="580" width="255" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1_zD" value="D · FoodExpress monolith" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EAF5EA;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="p1_ec2">
          <mxGeometry x="285" y="40" width="265" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p1_static" value="&lt;b&gt;Website (static files)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;public/&lt;/font&gt; HTML, CSS, JavaScript" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zD">
          <mxGeometry x="12" y="32" width="241" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p1_api" value="&lt;b&gt;JSON API&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/api/products&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/api/orders&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zD">
          <mxGeometry x="12" y="104" width="241" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p1_health" value="&lt;b&gt;Health check&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /health&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7083;strokeWidth=1.5;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1F2933;" vertex="1" parent="p1_zD">
