# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# NEVER commit the real .env file (it is listed in .gitignore).

# --- Application ---
PORT=3000
# "development" prints an email preview in the console when SMTP is not set up.
# "production" never fakes email: if SMTP is missing, the order is kept but the email is reported as not sent.
NODE_ENV=development
# Set to 1 when running behind a reverse proxy such as Nginx (so client IPs are read correctly).
TRUST_PROXY=0

# --- SMTP (used by Nodemailer) ---
# Example for Gmail: smtp.gmail.com / 587 / false  (use an "App Password", not your normal password)
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (usually port 587), true = implicit TLS (usually port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FoodExpress <orders@example.com>"
